DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/loa_monitoring?schema=public"
PORT=4001
JWT_SECRET="change-me-to-a-long-random-string"
# OAuth Client ID from Google Cloud Console (Credentials -> OAuth client ID -> Web application).
# Must match the same value the client uses (VITE_GOOGLE_CLIENT_ID). Required only for
# "Sign in with Google" (POST /api/auth/google) -- normal email/password login works without it.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
