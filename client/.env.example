VITE_API_URL=http://localhost:4001/api
# Same OAuth Client ID as the server's GOOGLE_CLIENT_ID (server/.env.example) --
# this one is public (baked into the client bundle), the server one is what
# actually verifies tokens. Required only for "Sign in with Google" on the
# login page; leave blank to keep only email/password login.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
