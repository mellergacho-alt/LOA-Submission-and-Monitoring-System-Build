## Used only by `npm run build` (vite build defaults to --mode production,
## which loads this file instead of .env). VITE_API_URL is a relative path
## rather than an absolute http://host:port URL because the production
## build is served by the same Express process as the API (see BUILD.md)
## -- frontend and backend are same-origin, so no host/IP needs to be baked
## in at build time, and this value never needs to change no matter what
## domain or IP the server ends up reachable at.
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID="437040176136-bq5umcf2mgr3s5h28vhevj5rf04710tt.apps.googleusercontent.com"
